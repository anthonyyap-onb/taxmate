# Required
OPENAI_API_KEY=
# Optional (tracing) — get these from your Langfuse Cloud project settings
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional overrides
TAXMATE_CHAT_MODEL=gpt-4o-mini
TAXMATE_EMBED_MODEL=text-embedding-3-small
TAXMATE_LOG_LEVEL=INFO
# Caching (optional): saved document index, response cache, semantic-hit threshold ("off" = exact only)
TAXMATE_CACHE_DIR=.cache
TAXMATE_RESPONSE_CACHE=on
TAXMATE_SEMANTIC_THRESHOLD=0.95
TAXMATE_CACHE_TTL_DAYS=7
# Shows cache stats and a "Clear cache" button in the sidebar. Leave off in production.
TAXMATE_ADMIN=
